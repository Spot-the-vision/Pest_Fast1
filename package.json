{
  "name": "pest-free",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node server.mjs",
    "serve": "node server.mjs",
    "build": "node build-single.mjs",
    "build:single": "node build-single.mjs",
    "build:turbo": "turbo run build",
    "dev": "node dev.mjs single",
    "dev:single": "node dev.mjs single",
    "dev:all": "node dev.mjs all",
    "dev:turbo": "turbo run dev",
    "dev:customer": "node dev.mjs customer",
    "dev:admin": "node dev.mjs admin",
    "dev:agency": "node dev.mjs agency",
    "dev:worker": "node dev.mjs worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "npm --prefix apps/customer-app test",
    "test:unit": "npm --prefix apps/customer-app test",
    "clean": "node -e \"const fs=require('fs'); ['dist','apps/admin-dashboard/dist','apps/agency-dashboard/dist','apps/customer-app/dist','apps/worker-app/dist','.turbo'].forEach(p => fs.rmSync(p, {recursive:true, force:true}));\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "framer-motion": "^13.4.6",
    "react-native-web": "^0.21.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
